--- /dev/null
+++ b/services/googleDrive.js
@@ -0,0 +1,98 @@
+import { randomBytes, createCipheriv, createDecipheriv, createHash } from "node:crypto";
+
+export const DRIVE_SCOPE = "https://www.googleapis.com/auth/drive.file";
+export const digestState = (state) => createHash("sha256").update(state).digest("hex");
+
+export function driveConfig() {
+  const { GOOGLE_CLIENT_ID: clientId, GOOGLE_CLIENT_SECRET: clientSecret,
+    GOOGLE_DRIVE_REDIRECT_URI: redirectUri, FRONTEND_URL: frontendUrl,
+    GOOGLE_DRIVE_TOKEN_KEY: key } = process.env;
+  if (!clientId || !clientSecret || !redirectUri || !frontendUrl || !/^[a-f\d]{64}$/i.test(key || "")) {
+    throw Object.assign(new Error("Google Drive is not configured on the server."), { status: 503 });
+  }
+  for (const value of [redirectUri, frontendUrl]) {
+    const url = new URL(value);
+    if (url.protocol !== "https:" && !(url.protocol === "http:" && url.hostname === "localhost")) {
+      throw new Error("Google Drive URLs must use HTTPS (or localhost for development).");
+    }
+  }
+  return { clientId, clientSecret, redirectUri, frontendUrl, key: Buffer.from(key, "hex") };
+}
+
+export function encryptToken(token) {
+  const iv = randomBytes(12);
+  const cipher = createCipheriv("aes-256-gcm", driveConfig().key, iv);
+  const ciphertext = Buffer.concat([cipher.update(token, "utf8"), cipher.final()]);
+  return Buffer.concat([iv, cipher.getAuthTag(), ciphertext]).toString("base64");
+}
+
+export function decryptToken(value) {
+  const data = Buffer.from(value, "base64");
+  const decipher = createDecipheriv("aes-256-gcm", driveConfig().key, data.subarray(0, 12));
+  decipher.setAuthTag(data.subarray(12, 28));
+  return Buffer.concat([decipher.update(data.subarray(28)), decipher.final()]).toString("utf8");
+}
+
+export async function exchangeToken(params) {
+  const { clientId, clientSecret } = driveConfig();
+  const response = await fetch("https://oauth2.googleapis.com/token", {
+    method: "POST", signal: AbortSignal.timeout(30000),
+    body: new URLSearchParams({ client_id: clientId, client_secret: clientSecret, ...params }),
+  });
+  const data = await response.json();
+  if (!response.ok || !data.access_token) {
+    throw Object.assign(new Error("Google Drive authorization expired or failed. Please reconnect Google Drive."), { status: 409 });
+  }
+  return data;
+}
+
+export async function accessToken(connection) {
+  const data = await exchangeToken({ grant_type: "refresh_token", refresh_token: decryptToken(connection.refreshToken) });
+  return data.access_token;
+}
+
+export async function driveRequest(token, path, options = {}) {
+  const response = await fetch(`https://www.googleapis.com/${path}`, {
+    ...options, signal: AbortSignal.timeout(60000),
+    headers: { ...options.headers, Authorization: `Bearer ${token}` },
+  });
+  if (!response.ok) {
+    const message = response.status === 401 ? "Please reconnect Google Drive."
+      : response.status === 403 ? "Google Drive denied access. Check permissions and available storage."
+      : response.status === 404 ? "Image or folder was not found in Google Drive."
+      : "Google Drive request failed. Please try again.";
+    throw Object.assign(new Error(message), { status: response.status === 404 ? 404 : 502 });
+  }
+  return response;
+}
+
+export async function createFolder(token) {
+  const response = await driveRequest(token, "drive/v3/files?fields=id", {
+    method: "POST", headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ name: "TechnovaHub Gallery", mimeType: "application/vnd.google-apps.folder" }),
+  });
+  return (await response.json()).id;
+}
+
+export async function uploadFile(token, folderId, file) {
+  const boundary = `technovahub_${randomBytes(16).toString("hex")}`;
+  const metadata = JSON.stringify({ name: file.originalname, parents: [folderId] });
+  const body = Buffer.concat([
+    Buffer.from(`--${boundary}\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n${metadata}\r\n--${boundary}\r\nContent-Type: ${file.mimetype}\r\n\r\n`),
+    file.buffer, Buffer.from(`\r\n--${boundary}--\r\n`),
+  ]);
+  const response = await driveRequest(token, "upload/drive/v3/files?uploadType=multipart&fields=id", {
+    method: "POST", headers: { "Content-Type": `multipart/related; boundary=${boundary}` }, body,
+  });
+  const data = await response.json();
+  if (!data.id) throw new Error("Google Drive did not return an uploaded file ID.");
+  return data.id;
+}
+
+export async function deleteFile(token, id) {
+  try {
+    await driveRequest(token, `drive/v3/files/${encodeURIComponent(id)}`, { method: "DELETE" });
+  } catch (error) {
+    if (error.status !== 404) throw error;
+  }
+}
