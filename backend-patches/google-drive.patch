@@ -0,0 +1,48 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { encryptToken, decryptToken, accessToken, uploadFile, deleteFile, DRIVE_SCOPE } from "../services/googleDrive.js";
+
+Object.assign(process.env, {
+  GOOGLE_CLIENT_ID: 'test-client', GOOGLE_CLIENT_SECRET: 'test-secret',
+  GOOGLE_DRIVE_REDIRECT_URI: 'http://localhost:9000/api/auth/google-drive/callback',
+  FRONTEND_URL: 'http://localhost:5173', GOOGLE_DRIVE_TOKEN_KEY: 'ab'.repeat(32),
+});
+
+test('refresh tokens are encrypted with authenticated, randomized ciphertext', () => {
+  const first = encryptToken('private-refresh-token');
+  assert.notEqual(first, encryptToken('private-refresh-token'));
+  assert.equal(decryptToken(first), 'private-refresh-token');
+  const tampered = Buffer.from(first, 'base64');
+  tampered[30] ^= 1;
+  assert.throws(() => decryptToken(tampered.toString('base64')));
+});
+
+test('refresh uses server credentials; upload keeps binary content and folder metadata', async (t) => {
+  const file = { originalname: 'photo "one".png', mimetype: 'image/png', buffer: Buffer.from([0, 255, 128, 10, 13]) };
+  const calls = [];
+  t.mock.method(globalThis, 'fetch', async (url, options) => {
+    calls.push({ url, options });
+    return new Response(JSON.stringify(calls.length === 1 ? { access_token: 'access', scope: DRIVE_SCOPE } : { id: 'drive-file' }));
+  });
+  const token = await accessToken({ refreshToken: encryptToken('refresh') });
+  assert.equal(calls[0].options.body.get('refresh_token'), 'refresh');
+  assert.equal(calls[0].options.body.get('client_secret'), 'test-secret');
+  assert.equal(await uploadFile(token, 'folder-id', file), 'drive-file');
+  const request = calls[1];
+  assert.equal(request.options.headers.Authorization, 'Bearer access');
+  assert.ok(request.url.includes('uploadType=multipart'));
+  assert.ok(request.options.body.includes(file.buffer));
+  assert.ok(request.options.body.toString().includes(JSON.stringify({ name: file.originalname, parents: ['folder-id'] })));
+});
+
+test('revoked connection returns an actionable reconnect error', async (t) => {
+  t.mock.method(globalThis, 'fetch', async () => new Response(JSON.stringify({ error: 'invalid_grant' }), { status: 400 }));
+  await assert.rejects(accessToken({ refreshToken: encryptToken('revoked') }), /reconnect Google Drive/);
+});
+
+test('deletion tolerates a file already removed from Drive but rejects permission failures', async (t) => {
+  const fetchMock = t.mock.method(globalThis, 'fetch', async () => new Response('', { status: 404 }));
+  await deleteFile('access', 'missing-file');
+  fetchMock.mock.mockImplementation(async () => new Response('', { status: 403 }));
+  await assert.rejects(deleteFile('access', 'forbidden-file'), /denied access/);
+});
