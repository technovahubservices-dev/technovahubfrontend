@@ -0,0 +1,57 @@
+import { randomBytes } from "node:crypto";
+import Connection from "../models/GoogleDriveConnection.js";
+import State from "../models/GoogleDriveState.js";
+import { DRIVE_SCOPE, digestState, driveConfig, encryptToken, exchangeToken, createFolder } from "../services/googleDrive.js";
+
+export async function getDriveStatus(req, res) {
+  try {
+    driveConfig();
+    const connection = await Connection.findOne({ admin: req.admin._id }).sort({ createdAt: -1 });
+    res.json({ connected: Boolean(connection) });
+  } catch (error) { res.status(error.status || 500).json({ message: error.message }); }
+}
+
+export async function connectDrive(req, res) {
+  try {
+    const { clientId, redirectUri } = driveConfig();
+    const state = randomBytes(32).toString("hex");
+    await State.create({ digest: digestState(state), admin: req.admin._id, expiresAt: new Date(Date.now() + 600000) });
+    const url = new URL("https://accounts.google.com/o/oauth2/v2/auth");
+    url.search = new URLSearchParams({ client_id: clientId, redirect_uri: redirectUri,
+      response_type: "code", scope: DRIVE_SCOPE, access_type: "offline", prompt: "consent", state }).toString();
+    res.set("Cache-Control", "no-store").json({ authorizationUrl: url.href, state });
+  } catch (error) { res.status(error.status || 500).json({ message: error.message }); }
+}
+
+// Finish using the initiating browser's session state and authenticated admin.
+export function driveCallback(req, res) {
+  try {
+    const url = new URL("/admin/gallery", driveConfig().frontendUrl);
+    const params = new URLSearchParams({ googleDrive: "callback" });
+    for (const name of ["code", "state", "error"]) {
+      if (typeof req.query[name] === "string") params.set(name, req.query[name]);
+    }
+    // Keep the code out of frontend HTTP request logs.
+    url.hash = params.toString();
+    res.set({ "Cache-Control": "no-store", "Referrer-Policy": "no-referrer" }).redirect(url.href);
+  } catch { res.status(503).send("Google Drive is not configured on the server."); }
+}
+
+export async function completeDrive(req, res) {
+  try {
+    const { code, state } = req.body;
+    if (typeof code !== "string" || typeof state !== "string" || !/^[a-f\d]{64}$/.test(state)) {
+      return res.status(400).json({ message: "Invalid Google Drive connection response." });
+    }
+    const pending = await State.findOneAndDelete({ digest: digestState(state), admin: req.admin._id, expiresAt: { $gt: new Date() } });
+    if (!pending) return res.status(400).json({ message: "Connection request expired or was already used. Please try again." });
+    const tokens = await exchangeToken({ code, grant_type: "authorization_code", redirect_uri: driveConfig().redirectUri });
+    if (!tokens.refresh_token || !tokens.scope?.split(" ").includes(DRIVE_SCOPE)) {
+      return res.status(400).json({ message: "Please reconnect and allow Google Drive file access." });
+    }
+    const folderId = await createFolder(tokens.access_token);
+    // Old images keep using their original connection when an admin reconnects.
+    await Connection.create({ admin: req.admin._id, refreshToken: encryptToken(tokens.refresh_token), folderId });
+    res.set("Cache-Control", "no-store").json({ connected: true });
+  } catch (error) { res.status(error.status || 500).json({ message: error.message }); }
+}
