@@ -0,0 +1,92 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { SourceTextModule, SyntheticModule } from 'node:vm';
+
+async function controller(name, dependencies) {
+  const source = await readFile(new URL(`../controllers/${name}.js`, import.meta.url), 'utf8');
+  const module = new SourceTextModule(source);
+  await module.link(async (specifier) => {
+    const values = dependencies[specifier];
+    assert.ok(values, `Missing test dependency ${specifier}`);
+    return new SyntheticModule(Object.keys(values), function () {
+      for (const [key, value] of Object.entries(values)) this.setExport(key, value);
+    });
+  });
+  await module.evaluate();
+  return module.namespace;
+}
+
+function response() {
+  return { statusCode: 200, status(value) { this.statusCode = value; return this; },
+    json(value) { this.body = value; return this; }, set() { return this; } };
+}
+
+test('OAuth completion atomically consumes state for the signed-in admin before exchanging code', async () => {
+  let queried;
+  let exchanges = 0;
+  const methods = await controller('googleDriveController', {
+    'node:crypto': { randomBytes() {} },
+    '../models/GoogleDriveConnection.js': { default: {} },
+    '../models/GoogleDriveState.js': { default: { async findOneAndDelete(query) { queried = query; return null; } } },
+    '../services/googleDrive.js': { DRIVE_SCOPE: 'drive.file', digestState: (s) => `hash:${s}`,
+      driveConfig() {}, encryptToken() {}, exchangeToken() { exchanges++; }, createFolder() {} },
+  });
+  const res = response();
+  await methods.completeDrive({ body: { code: 'code', state: 'ab'.repeat(32) }, admin: { _id: 'admin-1' } }, res);
+  assert.equal(queried.admin, 'admin-1');
+  assert.ok(queried.expiresAt.$gt instanceof Date);
+  assert.equal(res.statusCode, 400);
+  assert.equal(exchanges, 0);
+});
+
+async function uploadController({ connection = {}, failSecond = false, dbFailure = false, persisted = false } = {}) {
+  const uploaded = [], deleted = [];
+  let saved;
+  class ObjectId { toString() { return 'gallery-id'; } }
+  const methods = await controller('galleryController', {
+    mongoose: { default: { Types: { ObjectId } } },
+    '../config/cloudinary.js': { default: {} },
+    '../models/GalleryModels.js': { default: {
+      async insertMany(records) { saved = records; if (dbFailure) throw new Error('database unavailable'); return records.map((r) => ({ toObject: () => ({ ...r }) })); },
+      async exists() { return persisted; },
+    } },
+    '../models/GoogleDriveConnection.js': { default: { findOne() { return { sort() { return { select: async () => connection }; } }; } } },
+    '../services/googleDrive.js': {
+      accessToken: async () => 'access',
+      uploadFile: async () => { if (failSecond && uploaded.length) throw new Error('quota exceeded'); const id = `file-${uploaded.length}`; uploaded.push(id); return id; },
+      deleteFile: async (token, id) => deleted.push(id), driveRequest() {},
+    },
+  });
+  const req = { admin: { _id: 'admin-1' }, files: [{ mimetype: 'image/png' }, { mimetype: 'image/jpeg' }] };
+  const res = response();
+  await methods.uploadImages(req, res);
+  return { res, saved, uploaded, deleted };
+}
+
+test('upload requires a connected Drive', async () => {
+  const { res, uploaded } = await uploadController({ connection: null });
+  assert.equal(res.statusCode, 409);
+  assert.equal(uploaded.length, 0);
+});
+
+test('upload records Drive IDs and gallery content URLs without returning connection references', async () => {
+  const { res, saved } = await uploadController({ connection: { _id: 'private-connection', folderId: 'folder' } });
+  assert.equal(res.statusCode, 201);
+  assert.equal(saved[0].storageProvider, 'google-drive');
+  assert.equal(saved[0].driveFileId, 'file-0');
+  assert.equal(saved[0].imageUrl, '/api/gallery/gallery-id/content');
+  assert.equal(saved[0].driveConnection, 'private-connection');
+  assert.equal(res.body[0].driveConnection, undefined);
+});
+
+test('failed batch upload removes previously uploaded files', async () => {
+  const { res, deleted } = await uploadController({ failSecond: true });
+  assert.equal(res.statusCode, 500);
+  assert.deepEqual(deleted, ['file-0']);
+});
+
+test('database failure cleans up unrecorded files but preserves partially saved records', async () => {
+  assert.deepEqual((await uploadController({ dbFailure: true })).deleted, ['file-0', 'file-1']);
+  assert.deepEqual((await uploadController({ dbFailure: true, persisted: true })).deleted, []);
+});
